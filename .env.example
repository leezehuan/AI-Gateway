# AI Gateway. Copy this file to .env before using the Gateway run script. Identity, budgets,
# Usage, routing, and Attempt audits use MySQL;
# shared routing health, rolling RPM, and concurrency leases use Redis. Node capacity and drain
# are process-local; use a distinct listen port for each instance.
AI_GATEWAY_LISTEN_ADDRESS=127.0.0.1
AI_GATEWAY_LISTEN_PORT=8080
AI_GATEWAY_DB_HOST=127.0.0.1
AI_GATEWAY_DB_PORT=3306
AI_GATEWAY_DB_USER=ai_gateway
AI_GATEWAY_DB_PASSWORD=
AI_GATEWAY_DB_NAME=ai_gateway
AI_GATEWAY_DB_CONNECT_TIMEOUT_SECONDS=2
AI_GATEWAY_DB_POOL_SIZE=4
AI_GATEWAY_DB_WORKERS=4
AI_GATEWAY_DB_QUEUE_SIZE=1024
AI_GATEWAY_API_KEY_HMAC_PEPPER=
AI_GATEWAY_SECRET_DIR=/run/secrets/ai-gateway
AI_GATEWAY_AUTH_CACHE_TTL_SECONDS=30
AI_GATEWAY_AUTH_CACHE_MAX_ENTRIES=10000
AI_GATEWAY_CONFIG_POLL_INTERVAL_MS=1000
AI_GATEWAY_MAX_BODY_BYTES=1048576
AI_GATEWAY_MAX_RESPONSE_BYTES=16777216
AI_GATEWAY_UPSTREAM_TIMEOUT_MS=30000
AI_GATEWAY_STREAM_PREFETCH_BYTES=65536
AI_GATEWAY_STREAM_BUFFER_HIGH_WATER_BYTES=262144
AI_GATEWAY_STREAM_BUFFER_LOW_WATER_BYTES=65536
AI_GATEWAY_STREAM_IDLE_TIMEOUT_MS=60000
AI_GATEWAY_STREAM_MAX_DURATION_MS=900000
AI_GATEWAY_IO_THREADS=2
AI_GATEWAY_MAX_ACTIVE_REQUESTS=256
AI_GATEWAY_MAX_ACTIVE_STREAMS=128
AI_GATEWAY_CURL_MAX_TOTAL_CONNECTIONS=128
AI_GATEWAY_CURL_MAX_HOST_CONNECTIONS=64
AI_GATEWAY_DRAIN_TIMEOUT_MS=60000
AI_GATEWAY_SHUTDOWN_CANCEL_GRACE_MS=5000
AI_GATEWAY_REDIS_HOST=127.0.0.1
AI_GATEWAY_REDIS_PORT=6379
AI_GATEWAY_REDIS_USERNAME=
AI_GATEWAY_REDIS_PASSWORD=
AI_GATEWAY_REDIS_DATABASE=0
AI_GATEWAY_REDIS_WORKERS=2
AI_GATEWAY_REDIS_QUEUE_SIZE=4096
AI_GATEWAY_REDIS_CONNECT_TIMEOUT_MS=1000
AI_GATEWAY_REDIS_COMMAND_TIMEOUT_MS=500
AI_GATEWAY_REDIS_KEY_PREFIX=aigw
AI_GATEWAY_AFFINITY_TTL_SECONDS=300
AI_GATEWAY_ROUTING_HEALTH_TTL_SECONDS=3600
AI_GATEWAY_CIRCUIT_FAILURE_THRESHOLD=3
AI_GATEWAY_CIRCUIT_OPEN_MS=30000
AI_GATEWAY_CIRCUIT_PROBE_LEASE_MS=10000
AI_GATEWAY_GOVERNANCE_LEASE_TTL_MS=120000
AI_GATEWAY_GOVERNANCE_LEASE_RENEW_MS=30000

# Referenced by config/ai-gateway.lingsuan.json. Keep the real value only in local runtime secrets.
LINGSUAN_API_KEY=
MOCK_PROVIDER_API_KEY=

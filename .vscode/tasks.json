{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "构建 JSON 测试",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++11",
                "${workspaceFolder}/test/testjson/testjson.cpp",
                "-I${workspaceFolder}/test/testjson",
                "-o",
                "${workspaceFolder}/test/testjson/testjson"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++ 生成活动文件",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。"
        }
    ]
}